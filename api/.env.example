# OpenAI API key (platform.openai.com), server-side only — never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=
# Chat model used for generation; check platform.openai.com/docs/pricing for the current mini model
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Embedding model; if it differs from the committed index, the API rebuilds the index at startup
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
